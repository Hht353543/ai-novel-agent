# ================= DeepSeek API =================
# 在 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.7
# 输出上限：大纲较长时建议 8192，过小会导致 JSON 被截断
DEEPSEEK_MAX_TOKENS=8192
# API 请求超时（秒）：避免网络异常时请求长时间挂起
DEEPSEEK_TIMEOUT=120
# 返回内容无法解析为 JSON 时，是否让模型自动修复一次（true/false）
DEEPSEEK_AUTO_REPAIR_JSON=true

# ============ Embedding / 向量库 ============
# 中文场景推荐：shibing624/text2vec-base-chinese
# 英文/多语言场景可选：paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=shibing624/text2vec-base-chinese
# true = 离线加载已下载的模型（默认，稳定）；false = 每次启动联网检查模型更新
EMBEDDING_OFFLINE=true
CHROMA_PERSIST_DIR=./vector_db
CHROMA_COLLECTION=novel_knowledge

# ============ 知识库 ============
KNOWLEDGE_DIR=./knowledge
CHUNK_SIZE=500
CHUNK_OVERLAP=80
# Markdown 结构化知识（novel_info / rag_chunks）使用更大的切片，保留主题完整性
MARKDOWN_CHUNK_SIZE=1500
MARKDOWN_CHUNK_OVERLAP=200
# 生成时按板块读取 txt 原文，每个板块最多注入的字符数
KNOWLEDGE_CATEGORY_MAX_CHARS=8000
# 单个 txt 文件最多注入的字符数（超出取开头并截断）
KNOWLEDGE_FILE_MAX_CHARS=2000
# 长原文摘要压缩（默认 false=直接截断；true=用 DeepSeek 分块压缩后注入，
# 注意：小说原文过大时压缩会很慢，请按实际文件大小谨慎开启）
KNOWLEDGE_COMPRESS=false
# 每个板块最多参与压缩的原文长度（字符）
KNOWLEDGE_COMPRESS_SOURCE_MAX=30000
# 压缩分块大小（字符）
KNOWLEDGE_COMPRESS_CHUNK_SIZE=2500
# 每块摘要目标字数
KNOWLEDGE_COMPRESS_SUMMARY_MAX=700
# 压缩并发线程数
KNOWLEDGE_COMPRESS_WORKERS=4
# 压缩后每个板块最多注入的字符数
KNOWLEDGE_CATEGORY_MAX_CHARS_COMPRESSED=16000

# ============ RAG 检索 ============
RETRIEVER_TOP_K=4
# 分组检索：每个知识库板块取几条，保证人物/世界观/剧情/技巧都有覆盖
RETRIEVER_PER_CATEGORY=2

# ============ 大纲卷章规划 ============
# 每章标准字数：总章数 = ceil(总字数 / 每章字数)
OUTLINE_CHAPTER_WORDS=4000
# 约每多少章分一卷（卷数会夹在上下限之间）
OUTLINE_CHAPTERS_PER_VOLUME=30
OUTLINE_VOLUME_MIN=3
OUTLINE_VOLUME_MAX=8
# 解析不出字数规模时的默认总字数
OUTLINE_DEFAULT_TOTAL_WORDS=1000000

# ============ 服务 ============
APP_NAME=AI 网文作者 Agent
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
