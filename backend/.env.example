# ================= DeepSeek API =================
# 在 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/
DEEPSEEK_MODEL=deepseek-chat
# 模型降级列表（逗号分隔，可选）：主模型重试失败后按顺序切换
DEEPSEEK_MODELS=
DEEPSEEK_TEMPERATURE=0.7
# 输出上限：大纲较长时建议 8192，过小会导致 JSON 被截断
DEEPSEEK_MAX_TOKENS=8192
# API 请求超时（秒）：避免网络异常时请求长时间挂起
DEEPSEEK_TIMEOUT=120
# 连接阶段超时（秒）：与读取超时分离，快速失败
DEEPSEEK_CONNECT_TIMEOUT=10
# 429/5xx 可重试次数（每次重试指数退避）
LLM_MAX_RETRIES=2
# 重试退避基础延迟与上限（秒）
LLM_RETRY_BASE_DELAY=1.0
LLM_RETRY_MAX_DELAY=8.0
# LLM 成本估算单价（元/1k tokens；0 表示不估算，仅记录用量）
LLM_COST_PER_1K_INPUT=0
LLM_COST_PER_1K_OUTPUT=0
# 模型上下文窗口（token）：用于计算输入预算，防止超限
LLM_CONTEXT_TOKENS=65536
# 输入预算安全余量（token）
LLM_BUDGET_SAFETY_MARGIN=1024
# 返回内容无法解析为 JSON 时，是否让模型自动修复一次（true/false）
DEEPSEEK_AUTO_REPAIR_JSON=true

# ============ 知识库 ============
KNOWLEDGE_DIR=./knowledge
# 生成时按板块读取 txt 原文，每个板块最多注入的字符数
KNOWLEDGE_CATEGORY_MAX_CHARS=8000
# 单个 txt 文件最多注入的字符数（超出取开头并截断）
KNOWLEDGE_FILE_MAX_CHARS=2000
# 长原文摘要压缩（默认 false=直接截断；true=用 DeepSeek 分块压缩后注入，
# 注意：小说原文过大时压缩会很慢，请按实际文件大小谨慎开启）
KNOWLEDGE_COMPRESS=false
# 每个板块最多参与压缩的原文长度（字符）
KNOWLEDGE_COMPRESS_SOURCE_MAX=30000
# 压缩分块大小（字符）
KNOWLEDGE_COMPRESS_CHUNK_SIZE=2500
# 每块摘要目标字数
KNOWLEDGE_COMPRESS_SUMMARY_MAX=700
# 压缩并发线程数
KNOWLEDGE_COMPRESS_WORKERS=4
# 压缩后每个板块最多注入的字符数
KNOWLEDGE_CATEGORY_MAX_CHARS_COMPRESSED=16000
# 知识库注入结果的内存缓存（默认开启；文件/配置变更自动失效）
KNOWLEDGE_CACHE_ENABLED=true
# 知识库所有板块合计最多注入的字符数（防止压缩模式撑爆上下文）
KNOWLEDGE_MAX_TOTAL_CHARS=40000
# RAG 检索器：budget（默认，全量注入）或 keyword（轻量关键词检索）
RAG_RETRIEVER=budget
# 关键词检索每板块最多选中的文件数
RAG_KEYWORD_TOP_K=3
# 章节跨章记忆（滚动摘要）：默认关闭（每次生成会增加一次轻量 LLM 调用）
MEMORY_ENABLED=false
# 记忆摘要目标字数
MEMORY_SUMMARY_MAX_CHARS=800
# 章节审校（Reviewer）开关：默认关闭（每次审校会增加一次 LLM 调用）
REVIEW_ENABLED=false
# 灵感剧情板块是否参与生成
INSPIRATION_ENABLED=false

# ============ 大纲卷章规划 ============
# 每章标准字数：总章数 = ceil(总字数 / 每章字数)
OUTLINE_CHAPTER_WORDS=4000
# 约每多少章分一卷（卷数会夹在上下限之间）
OUTLINE_CHAPTERS_PER_VOLUME=30
OUTLINE_VOLUME_MIN=3
OUTLINE_VOLUME_MAX=8
# 解析不出字数规模时的默认总字数
OUTLINE_DEFAULT_TOTAL_WORDS=1000000

# ============ 服务 ============
# 直接运行 python app/main.py 时监听的地址（默认仅本机；局域网访问设 0.0.0.0）
ALLOW_LAN=127.0.0.1
# 项目存储：json（默认，向后兼容）或 sqlite（需先运行 python migrate_projects.py to-sqlite）
PROJECT_STORAGE=json
# 项目 JSON 存储文件（PROJECT_STORAGE=json 时使用）
PROJECTS_FILE=./data/projects.json
# 项目 SQLite 存储文件（PROJECT_STORAGE=sqlite 时使用）
PROJECT_DB=./data/projects.db
APP_NAME=AI 网文作者 Agent
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
